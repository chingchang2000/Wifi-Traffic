<Window x:Class="WifiTraffic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Traffic"
        Width="1380"
        Height="860"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="WiFi Traffic"/>
                <TextBlock Margin="0,5,0,0"
                           Foreground="{StaticResource Muted}"
                           Text="Windows network visibility • local data only"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="AdapterCombo"
                          Width="420"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"/>
                <Button x:Name="StartButton" Click="StartButton_Click" Content="Start capture"/>
                <Button x:Name="StopButton" Click="StopButton_Click" Content="Stop" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="4">
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="PACKETS"/>
                    <TextBlock x:Name="PacketCountText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="TRAFFIC"/>
                    <TextBlock x:Name="TrafficBytesText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0 B"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="DOMAINS"/>
                    <TextBlock x:Name="DomainCountText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="SOURCES"/>
                    <TextBlock x:Name="SourceCountText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="4" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}">
            <TabItem Header="Live traffic">
                <DataGrid x:Name="LiveGrid" Margin="8" ItemsSource="{Binding LiveTraffic}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90"/>
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="90"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceIp}" Width="150"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Endpoint}" Width="210"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                        <DataGridTextColumn Header="Domain / website" Binding="{Binding Domain}" Width="*"/>
                        <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Top websites">
                <Grid Margin="12">
                    <DataGrid x:Name="DomainsGrid" ItemsSource="{Binding TopDomains}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*"/>
                            <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="140"/>
                            <DataGridTextColumn Header="Observed bytes" Binding="{Binding Bytes}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Capture info">
                <ScrollViewer Margin="20">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="What WiFi Traffic can see"/>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="WiFi Traffic records packet metadata visible to this Windows PC. It can identify many domains from DNS queries, plain HTTP Host headers and TLS SNI. It does not decrypt HTTPS, record passwords, or save packet payloads."/>
                        <TextBlock Margin="0,20,0,0" FontSize="18" FontWeight="SemiBold" Text="Whole-network visibility"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="On a normal Wi-Fi client connection, Windows generally cannot see every other device's unicast traffic. For full-home-network monitoring, this PC must sit in the traffic path, for example as a gateway/hotspot, or receive mirrored traffic from supported network equipment."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#617083" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="Stopped"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="RefreshButton_Click" Content="Refresh"/>
                <Button Click="ClearButton_Click" Content="Clear history"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
