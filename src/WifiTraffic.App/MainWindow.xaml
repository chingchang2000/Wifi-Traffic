<Window x:Class="WifiTraffic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Traffic"
        Width="1380"
        Height="900"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="WiFi Traffic"/>
                <TextBlock x:Name="SubtitleText"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource Muted}"
                           Text="This PC mode • monitors traffic visible to this computer"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="ModeCombo"
                          Width="245"
                          SelectionChanged="ModeCombo_SelectionChanged"
                          SelectedIndex="0">
                    <ComboBoxItem Content="This PC only"/>
                    <ComboBoxItem Content="Whole Network / Router DNS"/>
                </ComboBox>

                <ComboBox x:Name="AdapterCombo"
                          Width="390"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"/>

                <Button x:Name="StartButton"
                        Click="StartButton_Click"
                        Content="Start capture"/>

                <Button x:Name="StopButton"
                        Click="StopButton_Click"
                        Content="Stop"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border x:Name="RouterDnsPanel"
                Grid.Row="1"
                Margin="4,16,4,0"
                Padding="16"
                CornerRadius="12"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Accent}"
                BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="Whole Network / Router DNS Mode"/>

                    <TextBlock Margin="0,7,20,0"
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               Text="Other devices stay connected to your normal router Wi-Fi. Set your router's LAN/DHCP DNS server to this PC's IP once, and WiFi Traffic will log DNS domains per device IP while forwarding requests to the internet."/>

                    <TextBlock Margin="0,10,20,0" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="This PC DNS address: "/>
                        <Run x:Name="RouterDnsIpText" Text="Detecting..."/>
                    </TextBlock>

                    <TextBlock Margin="0,4,20,0" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Detected router: "/>
                        <Run x:Name="RouterGatewayText" Text="Detecting..."/>
                    </TextBlock>

                    <TextBlock Margin="0,10,20,0"
                               TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Router setup: "/>
                        <Run Text="Open your router → LAN/DHCP/DNS settings → set Primary DNS to the PC address shown above → save. Devices can remain on the same Wi-Fi."/>
                    </TextBlock>

                    <TextBlock x:Name="RouterDnsStatusText"
                               Margin="0,8,20,0"
                               Foreground="{StaticResource Muted}"
                               Text="DNS sensor is stopped."/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Click="CopyDnsIpButton_Click" Content="Copy DNS IP"/>
                    <Button Click="OpenRouterButton_Click" Content="Open router"/>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Margin="0,16,0,0" Columns="4">
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="RECORDS"/>
                    <TextBlock x:Name="PacketCountText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="OBSERVED BYTES"/>
                    <TextBlock x:Name="TrafficBytesText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0 B"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="DOMAINS"/>
                    <TextBlock x:Name="DomainCountText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="SOURCES / DEVICES"/>
                    <TextBlock x:Name="SourceCountText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="4" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}">
            <TabItem Header="Live traffic">
                <DataGrid x:Name="LiveGrid" Margin="8" ItemsSource="{Binding LiveTraffic}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90"/>
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="150"/>
                        <DataGridTextColumn Header="Source / device IP" Binding="{Binding SourceIp}" Width="165"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Endpoint}" Width="210"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                        <DataGridTextColumn Header="Domain / website" Binding="{Binding Domain}" Width="*"/>
                        <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Top websites">
                <Grid Margin="12">
                    <DataGrid x:Name="DomainsGrid" ItemsSource="{Binding TopDomains}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*"/>
                            <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="140"/>
                            <DataGridTextColumn Header="Observed bytes" Binding="{Binding Bytes}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Capture info">
                <ScrollViewer Margin="20">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="What WiFi Traffic can see"/>

                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="This PC mode captures packet metadata visible to this Windows PC through Npcap."/>

                        <TextBlock Margin="0,20,0,0" FontSize="18" FontWeight="SemiBold" Text="Whole Network / Router DNS mode"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="Devices stay on the normal router Wi-Fi. The router hands out this PC as DNS, so DNS queries from network devices reach WiFi Traffic and can be logged by client IP. HTTPS content is not decrypted."/>

                        <TextBlock Margin="0,20,0,0" FontSize="18" FontWeight="SemiBold" Text="Limits"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="Router DNS mode shows domains, not full HTTPS URLs or page contents. Devices or apps using encrypted DNS, VPNs, private relay, hard-coded DNS or TLS ECH may reduce visibility. Full packet visibility for every device still requires router/gateway support or traffic mirroring."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#617083" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="Stopped"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="RefreshButton_Click" Content="Refresh dashboard"/>
                <Button Click="ClearButton_Click" Content="Clear history"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
