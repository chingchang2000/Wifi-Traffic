<Window x:Class="WifiTraffic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Traffic"
        Width="1440"
        Height="920"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.12,0.05" GradientOrigin="0.12,0.05" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#132237" Offset="0"/>
                <GradientStop Color="#090E16" Offset="0.42"/>
                <GradientStop Color="#070B11" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46"
                            Height="46"
                            CornerRadius="13"
                            Background="{StaticResource AccentSoft}"
                            BorderBrush="#285A8A"
                            BorderThickness="1">
                        <TextBlock Text="WT"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#8CC8FF"/>
                    </Border>

                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WiFi Traffic"
                                       FontSize="25"
                                       FontWeight="SemiBold"/>
                            <Border Margin="10,2,0,0"
                                    Padding="8,3"
                                    CornerRadius="10"
                                    Background="#122436"
                                    BorderBrush="#214664"
                                    BorderThickness="1">
                                <TextBlock Text="v0.5"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#86C7FF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SubtitleText"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="12"
                                   Text="This PC mode • live network visibility"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,8"
                        CornerRadius="12"
                        Background="#0C141E"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#617083"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText"
                                   Foreground="{StaticResource TextSoft}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Text="Ready"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Control center -->
            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="18"
                    Background="{StaticResource HeroGradient}"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="255"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MONITORING MODE"/>
                        <ComboBox x:Name="ModeCombo"
                                  Margin="0,7,0,0"
                                  SelectionChanged="ModeCombo_SelectionChanged"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="This PC only"/>
                            <ComboBoxItem Content="Whole Network / Router DNS"/>
                            <ComboBoxItem Content="No setup / Devices"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="AdapterField" Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="NETWORK ADAPTER"/>
                            <TextBlock x:Name="AdapterCountText"
                                       Grid.Column="1"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       Text="0 FOUND"/>
                        </Grid>

                        <ComboBox x:Name="AdapterCombo"
                                  Margin="0,7,0,0"
                                  ToolTip="Choose the physical Wi-Fi or Ethernet adapter you want to monitor">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{StaticResource Text}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button x:Name="StartButton"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="144"
                                Margin="0,0,8,0"
                                Click="StartButton_Click"
                                Content="Start capture"/>

                        <Button x:Name="StopButton"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="86"
                                Click="StopButton_Click"
                                Content="Stop"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Mode panels -->
            <Grid Grid.Row="4">
                <Border x:Name="DefaultInfoPanel"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                CornerRadius="10"
                                Background="{StaticResource AccentSoft}">
                            <TextBlock Text="●"
                                       Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="13"
                                       Text="Local capture ready"/>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Choose an adapter above. The adapter control is only shown in This PC mode, so it no longer looks disabled when another mode does not use it."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="RouterDnsPanel"
                        Style="{StaticResource Card}"
                        Padding="16"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Whole Network / Router DNS"/>
                            <TextBlock Margin="0,5,30,0"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Devices stay on your normal Wi-Fi. Router DNS mode can log requested domains per device IP after the router's LAN/DHCP DNS is pointed to this PC."/>

                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Border Padding="10,6"
                                        CornerRadius="9"
                                        Background="#0B141F"
                                        BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="PC DNS  "/>
                                        <TextBlock x:Name="RouterDnsIpText" FontSize="11" FontWeight="SemiBold" Text="Detecting..."/>
                                    </StackPanel>
                                </Border>

                                <Border Margin="8,0,0,0"
                                        Padding="10,6"
                                        CornerRadius="9"
                                        Background="#0B141F"
                                        BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="Router  "/>
                                        <TextBlock x:Name="RouterGatewayText" FontSize="11" FontWeight="SemiBold" Text="Detecting..."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="RouterDnsStatusText"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       Text="DNS sensor is stopped."/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Click="CopyDnsIpButton_Click"
                                    Content="Copy DNS IP"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Click="OpenRouterButton_Click"
                                    Content="Open router"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="NoSetupPanel"
                        Style="{StaticResource Card}"
                        Padding="16"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Zero-setup device discovery"/>
                            <TextBlock Margin="0,5,30,0"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="No router login, no DNS changes and no reconnecting devices. Scan the local LAN for IP, MAC and hostname information where available."/>
                            <TextBlock x:Name="NoSetupStatusText"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       Text="Ready to scan."/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="10,6"
                                CornerRadius="9"
                                Background="#241E12"
                                BorderBrush="#4D3B1B"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource Warning}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="DEVICE DISCOVERY ONLY"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Main content -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Network activity"/>
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Text="Live events, discovered devices and domain activity"/>
                            </StackPanel>

                            <TabControl Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0">
                                <TabItem Header="Live">
                                    <Grid Background="Transparent"/>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <TabControl Grid.Row="2"
                                    Background="Transparent"
                                    BorderThickness="0">
                            <TabItem Header="Live traffic">
                                <DataGrid x:Name="LiveGrid"
                                          Margin="0,10,0,0"
                                          ItemsSource="{Binding LiveTraffic}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TIME" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="78"/>
                                        <DataGridTextColumn Header="DIRECTION" Binding="{Binding Direction}" Width="150"/>
                                        <DataGridTextColumn Header="SOURCE / DEVICE" Binding="{Binding SourceIp}" Width="155"/>
                                        <DataGridTextColumn Header="DESTINATION" Binding="{Binding Endpoint}" Width="195"/>
                                        <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Protocol}" Width="82"/>
                                        <DataGridTextColumn Header="DOMAIN / WEBSITE" Binding="{Binding Domain}" Width="*"/>
                                        <DataGridTextColumn Header="BYTES" Binding="{Binding Bytes}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Devices">
                                <DataGrid Margin="0,10,0,0"
                                          ItemsSource="{Binding Devices}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="IP ADDRESS" Binding="{Binding IpAddress}" Width="170"/>
                                        <DataGridTextColumn Header="MAC ADDRESS" Binding="{Binding MacAddress}" Width="190"/>
                                        <DataGridTextColumn Header="HOSTNAME / DEVICE" Binding="{Binding HostName}" Width="*"/>
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="170"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Top websites">
                                <DataGrid x:Name="DomainsGrid"
                                          Margin="0,10,0,0"
                                          ItemsSource="{Binding TopDomains}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain}" Width="*"/>
                                        <DataGridTextColumn Header="HITS" Binding="{Binding Hits}" Width="130"/>
                                        <DataGridTextColumn Header="OBSERVED BYTES" Binding="{Binding Bytes}" Width="160"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Info">
                                <ScrollViewer Margin="2,14,4,4"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Text="Monitoring modes"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="This PC captures packet metadata that reaches the selected adapter. Router DNS can show many requested domains per device after DNS setup. No setup / Devices discovers LAN devices without router changes."/>

                                        <TextBlock Margin="0,20,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="Privacy by design"/>
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="WiFi Traffic does not decrypt HTTPS, capture passwords or store packet payload contents. Use it only on networks you own or are authorized to administer."/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <!-- Right rail -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}"
                            Padding="18"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="RECORDS"/>
                            <TextBlock x:Name="PacketCountText"
                                       Margin="0,8,0,0"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Text="0"/>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       Text="Stored network observations"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Padding="18"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="OBSERVED TRAFFIC"/>
                            <TextBlock x:Name="TrafficBytesText"
                                       Margin="0,8,0,0"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Text="0 B"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource Card}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="DOMAINS"/>
                                <TextBlock x:Name="DomainCountText"
                                           Margin="0,7,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="DEVICES"/>
                                <TextBlock x:Name="SourceCountText"
                                           Margin="0,7,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}"
                            Padding="16">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="Quick actions"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="0,12,0,0"
                                    Click="RefreshButton_Click"
                                    Content="Refresh dashboard"/>
                            <Button Style="{StaticResource DangerButton}"
                                    Margin="0,8,0,0"
                                    Click="ClearButton_Click"
                                    Content="Clear history"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="8">
                <TextBlock Foreground="{StaticResource Muted}"
                           FontSize="10"
                           Text="WiFi Traffic • Local-first network visibility • Windows"/>
                <TextBlock HorizontalAlignment="Right"
                           Foreground="{StaticResource Muted}"
                           FontSize="10"
                           Text="Captured data stays on this PC"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
