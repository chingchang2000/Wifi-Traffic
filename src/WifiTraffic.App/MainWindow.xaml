<Window x:Class="WifiTraffic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Traffic"
        Width="1380"
        Height="900"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="WiFi Traffic"/>
                <TextBlock x:Name="SubtitleText"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource Muted}"
                           Text="This PC mode • monitors traffic visible to this computer"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="ModeCombo"
                          Width="225"
                          SelectionChanged="ModeCombo_SelectionChanged"
                          SelectedIndex="0">
                    <ComboBoxItem Content="This PC only"/>
                    <ComboBoxItem Content="Whole Network / Gateway"/>
                </ComboBox>

                <ComboBox x:Name="AdapterCombo"
                          Width="390"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"/>

                <Button x:Name="StartButton"
                        Click="StartButton_Click"
                        Content="Start capture"/>

                <Button x:Name="StopButton"
                        Click="StopButton_Click"
                        Content="Stop"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border x:Name="GatewayPanel"
                Grid.Row="1"
                Margin="4,16,4,0"
                Padding="16"
                CornerRadius="12"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Accent}"
                BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="Whole Network / Gateway Mode"/>

                    <TextBlock Margin="0,7,20,0"
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               Text="To see other phones, consoles and PCs, connect them to this Windows PC's Mobile Hotspot. Their traffic then passes through this computer instead of going directly to the router."/>

                    <TextBlock Margin="0,10,20,0"
                               TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Setup: "/>
                        <Run Text="1) Open Mobile Hotspot  2) Turn it on  3) Connect the other devices to that hotspot  4) Click Refresh adapters  5) Choose the adapter marked ★ WHOLE NETWORK and start capture."/>
                    </TextBlock>

                    <TextBlock x:Name="GatewayStatusText"
                               Margin="0,8,20,0"
                               Foreground="{StaticResource Muted}"
                               Text="Hotspot adapter has not been checked yet."/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <Button Click="OpenHotspotButton_Click"
                            Content="Open Mobile Hotspot"/>
                    <Button Click="RefreshAdaptersButton_Click"
                            Content="Refresh adapters"/>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2"
                     Margin="0,16,0,0"
                     Columns="4">
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="PACKETS"/>
                    <TextBlock x:Name="PacketCountText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="TRAFFIC"/>
                    <TextBlock x:Name="TrafficBytesText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0 B"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="DOMAINS"/>
                    <TextBlock x:Name="DomainCountText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="18" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" Text="SOURCES / DEVICES"/>
                    <TextBlock x:Name="SourceCountText" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="4" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}">
            <TabItem Header="Live traffic">
                <DataGrid x:Name="LiveGrid" Margin="8" ItemsSource="{Binding LiveTraffic}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90"/>
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="150"/>
                        <DataGridTextColumn Header="Source / device IP" Binding="{Binding SourceIp}" Width="165"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Endpoint}" Width="210"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                        <DataGridTextColumn Header="Domain / website" Binding="{Binding Domain}" Width="*"/>
                        <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Top websites">
                <Grid Margin="12">
                    <DataGrid x:Name="DomainsGrid" ItemsSource="{Binding TopDomains}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*"/>
                            <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="140"/>
                            <DataGridTextColumn Header="Observed bytes" Binding="{Binding Bytes}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Capture info">
                <ScrollViewer Margin="20">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="What WiFi Traffic can see"/>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="WiFi Traffic records packet metadata visible to this Windows PC. It can identify many domains from DNS queries, plain HTTP Host headers and TLS SNI. It does not decrypt HTTPS, record passwords, or save packet payloads."/>

                        <TextBlock Margin="0,20,0,0" FontSize="18" FontWeight="SemiBold" Text="This PC mode"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="This mode normally sees only this computer's own unicast traffic plus broadcast/multicast traffic that reaches it."/>

                        <TextBlock Margin="0,20,0,0" FontSize="18" FontWeight="SemiBold" Text="Whole Network / Gateway mode"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="Other devices must send their traffic through this PC. The easiest Windows setup is Mobile Hotspot: connect the devices to the PC's hotspot and capture the hotspot virtual adapter marked with ★ WHOLE NETWORK."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#617083" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="Stopped"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="RefreshButton_Click" Content="Refresh dashboard"/>
                <Button Click="ClearButton_Click" Content="Clear history"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
